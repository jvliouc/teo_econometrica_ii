#(a) entrada de restauranes como función de ingreso y numero de competidores
# Yi=1 si Yi*>0; donde Yi*=Xi*Beta_1+Zi*Beta_2+u_i
# con Xi el ingreso, voy a suponer normal(10,1) y
#Zi numero de competidores que voy a suponer un random entero
set.seed(2026)
N<-1000
Xi<-rnorm(N,mean=5,sd=1) # supongamos que ingreso es 5 en promedio y distribuye normal
Zi<-rpois(N,3) #supongamos que el promedio esperado de competidores es 3 para un barrio por ejemplo
#voy a suponer arbitrariamente los parametros verdaderos como 0.5 para el ingreso
#y -0.2 (-1 me parece arbitrariamente excesivo, no tengo razones de peso sinceramente, deberia funcionar)
#beta 0 =-2
ui<-rnorm(N,mean=0,sd=1)
Yi<--2+0.5*Xi-0.2*Zi+ui
y=as.numeric(Yi>0)
resto<-data.frame(Y=y,X=Xi,Z=Zi)
LPM<-lm(Y~X+Z,data = resto)
probit<-glm(Y~X+Z,family=binomial(link="probit"),data = resto)
logit<-glm(Y~X+Z,family=binomial(link="logit"),data = resto)
print(summary(LPM)$coefficients)
print(summary(probit)$coefficients)
print(summary(logit)$coefficients)
#(c)
#primero escribir las funciones que voy aoptimizar
X_mat <- cbind(1, resto$X, resto$Z) #como vector
Y_vec <- resto$Y
vero_probit <- function(beta, Y, X) {
xb <- X %*% beta
p <- pnorm(xb)
p <- pmax(pmin(p, 1 - 1e-15), 1e-15)
ll <- sum(Y * log(p) + (1 - Y) * log(1 - p))
return(-ll)
}
vero_logit <- function(beta, Y, X) {
xb <- X %*% beta
p <- plogis(xb)
p <- pmax(pmin(p, 1 - 1e-15), 1e-15)
ll <- sum(Y * log(p) + (1 - Y) * log(1 - p))
return(-ll)
}
#inicial
beta_i <- c(0, 0, 0)
opt_probit <- optim(beta_i, vero_probit, Y = Y_vec, X = X_mat, method = "BFGS")
opt_logit  <- optim(beta_i, vero_logit,  Y = Y_vec, X = X_mat, method = "BFGS")
opt_probit$par
opt_logit$par
#d
#poniendo los betas en vectores
b_lpm    <- as.numeric(coef(LPM))
b_probit <- opt_probit$par
b_logit  <- opt_logit$par
AME_lpm<-b_lpm #literalmente es un numero
AME_probit<-colMeans(dnorm(X_mat %*% b_probit,mean=0,sd=1) %*% b_probit)
#para el logit 1x1, me cuesta escribirlo matricialmente:
AME_logit_1 <- mean(dlogis(X_mat%*%b_logit)%*%t((1-dlogis(X_mat%*%b_logit)))*b_logit[1])
AME_logit_2 <- mean(dlogis(X_mat%*%b_logit)%*%t((1-dlogis(X_mat%*%b_logit)))*b_logit[2])
AME_logit_3 <- mean(dlogis(X_mat%*%b_logit)%*%t((1-dlogis(X_mat%*%b_logit)))*b_logit[3])
AME_logit<-c(AME_logit_1,AME_logit_1,AME_logit_1)
AME_logit
AME_logit<-c(AME_logit_1,AME_logit_2,AME_logit_3)
AME_logit
AME_probit
AME_lpm
#para el logit 1x1, me cuesta escribirlo matricialmente:
AME_logit_1 <- mean(dlogis(X_mat %*% b_logit) * b_logit[1])
AME_logit_2 <- mean(dlogis(X_mat %*% b_logit) * b_logit[2])
AME_logit_3 <- mean(dlogis(X_mat %*% b_logit) * b_logit[3])
AME_logit<-c(AME_logit_1,AME_logit_2,AME_logit_3)
AME_lpm
AME_lpm
AME_lpm
